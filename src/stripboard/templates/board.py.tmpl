"""$title -- stripboard layout.

Run:  python $filename   ->   $name.pdf   (DESIGN preview)
Set designing = False for the FRONT/BACK/DESIGN build sheet.
"""

from stripboard import project

designing = True


def draw(sb):
    sb.text(1, 'A', '$title')

